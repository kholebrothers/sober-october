// Sober October auf Cloudflare Workers: die Dateien aus public/, dazu ein kleiner Worker nur für
// /api/* — die Teilnahme der Gruppe (server/, nach dem Muster von kur-core) auf einer D1.
//
//   live:     https://sober-october.khole.workers.dev          (npm run deploy, main)
//   vorschau: https://<alias>-sober-october.khole.workers.dev  (npm run vorschau -- <alias>, jeder andere Branch)
//
// Live und Vorschauen teilen sich die D1. Getrennt sind sie über den Raum: der Worker gibt der
// Live-Adresse "live", allen anderen "vorschau" (server/worker.js). Eine Vorschau schreibt also nie
// in die Gruppe von live.
//
// Die D1 hat hier keine database_id: wrangler legt sie beim ersten Ausliefern an und behält sie danach
// über die Bindung des Workers. Dafür braucht der Token zusätzlich "Account · D1 · Edit" (README).
// Das Schema legt der Worker beim ersten Aufruf selbst an.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sober-october",
  "account_id": "2d0480b2b42b2779b9f237299c26524d",
  "main": "server/worker.js",
  "compatibility_date": "2026-09-26",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "sober-october"
    }
  ],
  "rules": [
    { "type": "Text", "globs": ["**/*.sql"], "fallthrough": true }
  ]
}
